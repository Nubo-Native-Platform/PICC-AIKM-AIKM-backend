# Config server bootstrap. These are required locally so the service can fetch
# its baseline config.
CONFIG_SERVER_URL=<CONFIG_SERVER_URL>
CONFIG_APP_NAME=<CONFIG_APP_NAME>
CONFIG_PROFILE=<CONFIG_PROFILE>
CONFIG_TAG=<CONFIG_TAG>
CONFIG_SERVER_TIMEOUT=5
CONFIG_SERVER_REQUIRED=true
ALLOW_LOCAL_CONFIG_OVERRIDES=true

# Local runtime values. Leave blank to use the config-server value.

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
LOG_LEVEL=INFO

# ---- CoreComp PostgreSQL ----
PG_HOST=<POSTGRES_HOST>
PG_PORT=<POSTGRES_PORT>
PG_DB=<POSTGRES_DATABASE>
PG_USER=<POSTGRES_USER>
PG_PASSWORD=<POSTGRES_PASSWORD>
PG_SCHEMA=<POSTGRES_SCHEMA>
PG_POOL_MIN=1
PG_POOL_MAX=10

# ---- Identity ----
USER_HEADER=<USER_HEADER>
DEFAULT_USER=<DEFAULT_USER>

# ---- Milvus ----
MILVUS_HOST=
MILVUS_PORT=
MILVUS_DB_NAME=

# ---- Provisioning service ----
PROVISION_ENABLED=false
PROVISION_SERVICE_URL=
PROVISION_DELETE_URL=
CALLBACK_BASE_URL=<CALLBACK_BASE_URL>

# ---- Ingestion service ----
INGESTION_ENABLED=false
INGESTION_SERVICE_URL=
INGESTION_DELETE_URL=

# ---- Outbound HTTP ----
HTTP_TIMEOUT=30

# ---- Runtime mode ----
MODEL_TYPE=local

# ---- Embeddings and summaries ----
OPENAI_API_KEY=
EMBEDDING_MODEL=
LOCAL_EMBEDDING_MODEL=
VANNA_LOCAL_EMBEDDING_MODEL=
VANNA_PUBLIC_EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
LOCAL_EMBEDDING_DIMENSION=
EMBEDDING_BATCH_SIZE=
CHUNK_SIZE_TOKENS=
CHUNK_OVERLAP_TOKENS=
NORMALIZE_EMBEDDINGS=
GET_SUMMARY_TIMEOUT_PUBLIC=
GET_SUMMARY_TIMEOUT_LOCAL=
PDF_VLM_LOCAL_MODEL=
PDF_VLM_PUBLIC_MODEL=

# ---- MinIO PDF visual artifacts ----
MINIO_HOST=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_SECURE=
MINIO_BUCKET=

# ---- Ollama ----
OLLAMA_BASE_URL=
OLLAMA_KEEP_ALIVE=
OLLAMA_NUM_CTX=

# ---- Vanna NL-to-SQL ----
PG_CONNECTION_STRING_VANNA=
VANNA_N_RESULTS=

# ---- RAG query service ----
RAG_QUERY_SERVICE_URL=<RAG_QUERY_SERVICE_URL>

# ---- NL-to-SQL generation ----
LLM_MODEL=
LLM_TEMPERATURE=
LLM_MAX_TOKENS=
SQL_MILVUS_COLLECTION=

# ---- Optional secrets/fallbacks ----
ANTHROPIC_API_KEY=
